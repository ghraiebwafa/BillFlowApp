<?xml version="1.0" encoding="utf-8"?>
<!--
  signatureValidationMode=accept avoids NU1301 when nuget.org repository-signatures
  is unreachable. If nuget.org itself is down, use the offline restore steps in
  scripts/refresh-nuget-local.sh (local feed under Backend/.nuget-local).
-->
<configuration>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-cache" value="./.nuget-local" />
  </packageSources>
</configuration>
