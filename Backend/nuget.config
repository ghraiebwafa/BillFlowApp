<?xml version="1.0" encoding="utf-8"?>
<!--
  signatureValidationMode=accept avoids NU1301 when nuget.org repository-signatures
  is unreachable. For offline restores when nuget.org is down, see
  scripts/refresh-nuget-local.sh (use source ./.nuget-local).
-->
<configuration>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
