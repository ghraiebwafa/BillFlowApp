# BillFlow monorepo environment (root .env — used by docker compose and local dotnet run)
# Setup: ./scripts/setup-env.sh

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=billflow
POSTGRES_USER=billflow
POSTGRES_PASSWORD=change_me
# Host port when using docker-compose.local.yml (use 5433 if 5432 is taken)
POSTGRES_PORT=5433

# Application DB (dotnet run on host — match POSTGRES_PORT above)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=billflow
DB_USER=billflow
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
# Host port when using docker-compose.local.yml (use 6381 if 6379 is taken)
REDIS_PORT=6381
REDIS_PASSWORD=change_me

# JWT / auth (setup-env.sh auto-generates secrets)
JWT_SECRET=change_me
JWT_ISSUER=BillFlow
JWT_AUDIENCE=BillFlow.Api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_PEPPER=change_me

# SuperAdmin bootstrap (setup-env.sh auto-generates password)
SUPERADMIN_EMAIL=superadmin@billflow.local
SUPERADMIN_PASSWORD=change_me
SUPERADMIN_FULL_NAME=BillFlow Super Admin

# HTTP ports (host)
AUTH_SERVICE_PORT=5237
MANAGEMENT_SERVICE_PORT=5177
FRONTEND_PORT=3000

# Feature flags
APPLY_MIGRATIONS=true
ALLOW_DEV_RESET_PASSWORD=false
REQUIRE_EMAIL_VERIFICATION=false

# Frontend build (docker compose prod + Vite local dev)
VITE_AUTH_API_URL=http://localhost:5237
VITE_MANAGEMENT_API_URL=http://localhost:5177

# Background jobs
OVERDUE_SYNC_INTERVAL_MINUTES=60
REFRESH_TOKEN_CLEANUP_INTERVAL_HOURS=24

# Database SSL (production managed Postgres — e.g. Require, VerifyFull)
DB_SSL_MODE=

# CORS (production — comma-separated origins)
CORS_ALLOWED_ORIGINS=
